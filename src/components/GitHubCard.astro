---
interface Props {
  /** owner/repo, e.g. "betich/tracker" */
  repo: string;
  description?: string;
  /** optional deployed URL, shown as a second chip */
  live?: string;
}

const { repo, description, live } = Astro.props;
const [owner, name] = repo.split("/");
const liveLabel = live?.replace(/^https?:\/\//, "").replace(/\/$/, "");
---

<div class="not-prose my-6">
  <a class="gh-card" href={`https://github.com/${repo}`} target="_blank" rel="noopener noreferrer">
    <span class="gh-card-sheen" aria-hidden="true"></span>

    <span class="gh-card-body">
      <svg class="gh-card-mark" viewBox="0 0 16 16" aria-hidden="true">
        <path
          fill="currentColor"
          d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
        ></path>
      </svg>

      <span class="gh-card-text">
        <span class="gh-card-repo">
          <span class="gh-card-owner">{owner}/</span><span class="gh-card-name">{name}</span>
        </span>
        {description && <span class="gh-card-desc">{description}</span>}
        <span class="gh-card-meta">
          <span class="gh-card-chip">github.com</span>
          {liveLabel && <span class="gh-card-chip gh-card-chip-live">{liveLabel}</span>}
        </span>
      </span>

      <svg class="gh-card-arrow" viewBox="0 0 24 24" aria-hidden="true">
        <path
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M7 17 17 7M9 7h8v8"></path>
      </svg>
    </span>
  </a>
</div>

<style>
  .gh-card {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: 0.85rem;
    padding: 1px; /* gradient hairline border */
    background: linear-gradient(135deg, #8b88ff 0%, #4845da 40%, #211f6b 100%);
    background-size: 200% 200%;
    background-position: 0% 50%;
    text-decoration: none;
    box-shadow: 0 1px 2px rgb(32 30 90 / 0.18);
    transition:
      background-position 0.7s ease,
      transform 0.25s ease,
      box-shadow 0.25s ease;
  }

  .gh-card:hover {
    background-position: 100% 50%;
    transform: translateY(-2px);
    box-shadow: 0 10px 24px -8px rgb(72 69 218 / 0.55);
  }

  .gh-card-body {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    border-radius: calc(0.85rem - 1px);
    padding: 1rem 1.1rem;
    background: linear-gradient(135deg, #4845da 0%, #3b2fb0 55%, #1c1a52 100%);
    background-size: 180% 180%;
    background-position: 0% 50%;
    transition: background-position 0.7s ease;
  }

  .gh-card:hover .gh-card-body {
    background-position: 100% 50%;
  }

  /* Soft highlight that sweeps across on hover. */
  .gh-card-sheen {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    background: linear-gradient(105deg, transparent 35%, rgb(255 255 255 / 0.16) 50%, transparent 65%);
    transform: translateX(-100%);
    transition: transform 0.8s ease;
  }

  .gh-card:hover .gh-card-sheen {
    transform: translateX(100%);
  }

  .gh-card-mark {
    flex-shrink: 0;
    width: 1.55rem;
    height: 1.55rem;
    margin-top: 0.1rem;
    color: #fff;
    opacity: 0.95;
  }

  .gh-card-text {
    display: flex;
    min-width: 0;
    flex: 1;
    flex-direction: column;
    gap: 0.3rem;
  }

  .gh-card-repo {
    font-family: "Roboto Mono", "Sarabun", monospace;
    font-size: 0.9rem;
    line-height: 1.3;
    color: #fff;
    word-break: break-word;
  }

  .gh-card-owner {
    opacity: 0.6;
  }

  .gh-card-name {
    font-weight: 700;
  }

  .gh-card-desc {
    font-size: 0.8rem;
    line-height: 1.45;
    color: rgb(255 255 255 / 0.72);
  }

  .gh-card-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.15rem;
  }

  .gh-card-chip {
    border-radius: 999px;
    border: 1px solid rgb(255 255 255 / 0.22);
    padding: 0.1rem 0.5rem;
    font-family: "Roboto Mono", "Sarabun", monospace;
    font-size: 0.65rem;
    letter-spacing: 0.04em;
    color: rgb(255 255 255 / 0.7);
  }

  .gh-card-chip-live {
    border-color: rgb(255 255 255 / 0.35);
    background: rgb(255 255 255 / 0.12);
    color: #fff;
  }

  .gh-card-arrow {
    flex-shrink: 0;
    width: 1.05rem;
    height: 1.05rem;
    margin-top: 0.25rem;
    color: rgb(255 255 255 / 0.55);
    transition:
      transform 0.25s ease,
      color 0.25s ease;
  }

  .gh-card:hover .gh-card-arrow {
    transform: translate(2px, -2px);
    color: #fff;
  }

  @media (prefers-reduced-motion: reduce) {
    .gh-card,
    .gh-card-body,
    .gh-card-sheen,
    .gh-card-arrow {
      transition: none;
    }
    .gh-card:hover {
      transform: none;
    }
    .gh-card:hover .gh-card-sheen {
      transform: translateX(-100%);
    }
  }
</style>

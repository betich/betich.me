{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/track",
      "destination": "https://track.betich.me/",
      "permanent": true
    },
    {
      "source": "/track/admin",
      "destination": "https://track.betich.me/admin",
      "permanent": true
    },
    {
      "source": "/track/:path*",
      "destination": "https://track.betich.me/:path*",
      "permanent": true
    }
  ]
}

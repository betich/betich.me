---
import BaseLayout from "@/layouts/BaseLayout.astro";
import TrackApp from "@/components/track/TrackApp";
---

<BaseLayout
  title="bundit"
  description="Which way is the bundit, and how far."
  className="bg-[#08071c]"
  themeColor="#08071c"
  viewport="width=device-width, initial-scale=1, viewport-fit=cover"
  noindex
>
  <!--
    client:only because the whole screen is built from live sensors — there is
    nothing meaningful to render on the server.
  -->
  <TrackApp client:only="react" />
</BaseLayout>

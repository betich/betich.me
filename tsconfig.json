{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "target": "ES6",
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@tracker/*": ["./worker/src/*"]
    }
  },
  // worker/ targets the Workers runtime and has its own tsconfig.
  "exclude": ["dist", "worker"],
  "plugins": [
    {
      "name": "@astrojs/ts-plugin"
    }
  ]
}
